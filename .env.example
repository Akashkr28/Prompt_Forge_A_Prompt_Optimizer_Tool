# Required: your Anthropic API key
ANTHROPIC_API_KEY=sk-ant-...

# Optional: override the model used for each role.
# Defaults are tuned for cost/quality: Sonnet for the roles that need stronger
# reasoning (running the prompt under test, rewriting it), Haiku for the
# evaluator since it is called most frequently (once per sample, every iteration).
OPTIMIZER_RUNNER_MODEL=claude-sonnet-4-6
OPTIMIZER_OPTIMIZER_MODEL=claude-sonnet-4-6
OPTIMIZER_EVALUATOR_MODEL=claude-haiku-4-5-20251001

# Optional: loop defaults (can also be overridden via CLI flags / dashboard controls)
OPTIMIZER_N_SAMPLES=3
OPTIMIZER_N_ITERATIONS=5

# Optional: where session history is stored
OPTIMIZER_DB_PATH=optimizer_history.db
