{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "api",
      "runtimeExecutable": ".venv/bin/uvicorn",
      "runtimeArgs": ["server.main:app", "--host", "0.0.0.0", "--port", "8000"],
      "port": 8000
    },
    {
      "name": "web",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "cwd": "web",
      "port": 3000
    },
    {
      "name": "dashboard (legacy Streamlit)",
      "runtimeExecutable": ".venv/bin/streamlit",
      "runtimeArgs": ["run", "dashboard/app.py", "--server.headless", "true", "--server.port", "8501"],
      "port": 8501
    }
  ]
}
